# Generate with: openssl rand -base64 32
APP_ENCRYPTION_SECRET=
# Comma-separated previous 32-byte base64 secrets kept only during credential migration.
APP_ENCRYPTION_PREVIOUS_SECRETS=

# Upstash Redis REST credentials. Never expose these through NEXT_PUBLIC_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin used for same-origin checks and canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
